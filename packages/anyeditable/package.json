{
  "name": "@p/anyeditable",
  "version": "0.4.0",
  "description": "Headless React kernels for any text-editable surface. useEditable covers input/textarea/select inline edits; useEditableSurface covers contenteditable visual surfaces, composers, triggers, and atomic chips.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "react",
    "edit",
    "inline-edit",
    "contenteditable",
    "editable-surface",
    "mention",
    "slash-command",
    "ime",
    "composition",
    "hangul",
    "headless",
    "aria"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": ">=4",
    "@p/aria-kernel": "*",
    "zod-crud": ">=0.9"
  },
  "peerDependenciesMeta": {
    "@p/aria-kernel": { "optional": true },
    "zod-crud": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "@p/aria-kernel": "file:../../../ds/packages/aria-kernel",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^29.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.4.3",
    "zod-crud": "file:../../../zod-crud/packages/zod-crud"
  }
}
