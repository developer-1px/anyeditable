{
  "name": "@p/anyeditable",
  "version": "0.4.0",
  "description": "Headless React kernel for any text-editable surface (<input>, <textarea>, contenteditable). v0.2 useEditable (cell/single-line, IME-safe). v0.3 useEditableComposer (chat composer: @-mention + /-command + atomic chips, dogfooded with @p/aria-kernel + zod-crud). Vocabulary closed under W3C/IETF/WAI standards.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "react",
    "edit",
    "inline-edit",
    "contenteditable",
    "chat-composer",
    "mention",
    "slash-command",
    "ime",
    "composition",
    "hangul",
    "headless",
    "aria"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": ">=4",
    "@p/aria-kernel": "*",
    "zod-crud": ">=0.9"
  },
  "peerDependenciesMeta": {
    "@p/aria-kernel": { "optional": true },
    "zod-crud": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "@p/aria-kernel": "file:../../../ds/packages/aria-kernel",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^29.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.4.3",
    "zod-crud": "file:../../../zod-crud/packages/zod-crud"
  }
}
