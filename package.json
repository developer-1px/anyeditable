{
  "name": "anyeditable-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @interactive-os/anyeditable",
    "test": "npm test -w @interactive-os/anyeditable",
    "typecheck": "npm run typecheck -w @interactive-os/anyeditable",
    "verify": "npm run typecheck && npm test && npm run build",
    "dev": "npm run dev -w composer-demo",
    "demo:build": "npm run build -w composer-demo"
  }
}
